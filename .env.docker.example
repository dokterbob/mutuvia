# Mutuvia — Docker deployment environment
# Copy to .env before running: docker compose --profile sqlite up
#                           or: docker compose --profile postgres up

# ── Required ──────────────────────────────────────────────────────────────────

# Public URL of your deployment (used in QR links and auth callbacks)
APP_URL=https://your-domain.com

# Secret key for signing QR JWT tokens (min 32 characters)
QR_JWT_SECRET=change-me-to-a-random-32-char-secret!!

# Secret key for Better Auth sessions (min 32 characters). This placeholder
# is deliberately invalid — the app refuses to start with it.
BETTER_AUTH_SECRET=REPLACE_ME_RUN_bun_run_generate-secret

# ── Database ──────────────────────────────────────────────────────────────────
# For --profile sqlite: no extra config needed (defaults apply)
# For --profile postgres: set DATABASE_URL (password must match POSTGRES_PASSWORD below)
# DATABASE_URL=postgresql://mutuvia:change-me@postgres:5432/mutuvia
# POSTGRES_PASSWORD=change-me

# ── Rate limiting / abuse prevention ────────────────────────────────────────
# If a reverse proxy sits in front of this container, set ADDRESS_HEADER
# (and usually XFF_DEPTH) — svelte-adapter-bun's own env vars — so the app's
# rate limiter buckets real visitor IPs instead of the proxy's own address.
# See README's "Reverse proxy / client IP" section.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
# Comma-separated ISO 3166-1 alpha-2 country codes (e.g. PT,NL,DE,ES,FR) to
# restrict phone sign-up/OTP to — an SMS-pumping (toll fraud) defense. Leave
# unset for no restriction.
# PHONE_COUNTRY_ALLOWLIST=

# ── Prelude (SMS OTP) ────────────────────────────────────────────────────────
# One of PRELUDE_API_TOKEN or SMTP_HOST is required — the app refuses to
# start without at least one. Leave DEV_LOG_OTP unset here; it does not count
# as a configured delivery channel and prints OTPs to the container logs if
# you ever turn it on (loud startup warning either way).
# DEV_LOG_OTP=true
PRELUDE_API_TOKEN=

# ── SMTP (Email OTP) ──────────────────────────────────────────────────────────
# Required for email OTP delivery in production. Works with any SMTP provider.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   # set true for port 465 (implicit TLS)
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mutuvia <noreply@example.com>"

# ── Security headers / Sentry sampling ──────────────────────────────────────
# HSTS_MAX_AGE_SECONDS=15552000
# HSTS_INCLUDE_SUBDOMAINS=false
# PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_TUNNEL_MAX_BODY_BYTES=5000000

# ── Optional ──────────────────────────────────────────────────────────────────
# PORT=3000
# PUBLIC_APP_NAME=Mutuvia
# PUBLIC_APP_TAGLINE="Together, we are more."
# UNIT_CODE=EUR
# PUBLIC_UNIT_SYMBOL=€
# PUBLIC_UNIT_DISPLAY_NAME=euro
# QR_TTL_SECONDS=259200
# REUSABLE_QR_TTL_SECONDS=2592000
# QR_MAX_TTL_SECONDS=2592000
# EXPIRED_QR_RETENTION_SECONDS=259200
# MAX_TRANSACTION_AMOUNT=100000000
# PUBLIC_COMMUNITY_DOC_URL=
# PUBLIC_SENTRY_DSN=
# PUBLIC_VAPID_KEY=
# PRIVATE_VAPID_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# PUSH_ENDPOINT_EXTRA_HOSTS=
