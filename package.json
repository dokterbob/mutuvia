{
	"name": "mutuvia",
	"private": true,
	"version": "0.5.0",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build && bun scripts/check-server-bundle.ts",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync || echo '' && git-hooks || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && bun scripts/check-translations.ts",
		"lint:fix": "prettier --write . && eslint . --fix --no-error-on-unmatched-pattern && bun scripts/check-translations.ts",
		"format": "prettier --write .",
		"test": "bun --bun vitest run",
		"test:unit": "bun --bun vitest",
		"test:e2e": "bun playwright test",
		"test:e2e:ui": "bun playwright test --ui",
		"db:generate:sqlite": "bun drizzle-kit generate --config drizzle.config.sqlite.ts",
		"db:generate:pg": "bun drizzle-kit generate --config drizzle.config.pg.ts",
		"db:generate": "echo 'Use db:generate:sqlite or db:generate:pg'",
		"db:migrate": "bun scripts/migrate.ts",
		"db:seed": "bun scripts/seed.ts",
		"db:push:pg": "bun drizzle-kit push --config drizzle.config.pg.ts",
		"generate-secret": "bun scripts/generate-secret.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.2",
		"@fontsource-variable/noto-sans": "^5.3.0",
		"@inlang/paraglide-js": "^2.15.1",
		"@inlang/plugin-m-function-matcher": "^2.4.3",
		"@inlang/plugin-message-format": "^4.6.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "1.65.1",
		"@prelude.so/sdk": "^0.16.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/bun": "^1.4.4",
		"@types/node": "^22",
		"@types/qrcode": "^1.5.6",
		"@types/web-push": "^3.6.4",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/browser-playwright": "^4.1.0",
		"@vitest/coverage-istanbul": "^4.1.2",
		"barcode-detector": "^3.2.4",
		"better-auth": "^1.7.25",
		"better-sqlite3": "^12.8.0",
		"bits-ui": "^2.21.0",
		"bun-git-hooks": "^0.3.1",
		"clsx": "^2.1.1",
		"country-flag-icons": "^1.6.20",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^29.0.1",
		"jsrepo": "^3.8.3",
		"mode-watcher": "^1.1.0",
		"playwright": "1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"qrcode": "^1.5.4",
		"svelte": "^5.57.3",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"svelte-tel-input": "^3.6.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^7.3.1",
		"vitest": "^4.1.2",
		"vitest-browser-svelte": "^2.0.2"
	},
	"git-hooks": {
		"pre-commit": {
			"staged-lint": {
				"*": "prettier --write --ignore-unknown",
				"**/*.{js,ts}": "eslint --fix --no-error-on-unmatched-pattern"
			}
		},
		"commit-msg": "true"
	},
	"dependencies": {
		"@sentry/bun": "^10.46.0",
		"@sentry/sveltekit": "^10.46.0",
		"drizzle-orm": "^0.45.4",
		"libphonenumber-js": "^1.13.16",
		"nodemailer": "^10.5.0",
		"web-push": "^3.6.7"
	},
	"patchedDependencies": {
		"bun-git-hooks@0.3.1": "patches/bun-git-hooks@0.3.1.patch",
		"svelte-adapter-bun@1.0.1": "patches/svelte-adapter-bun@1.0.1.patch"
	}
}
