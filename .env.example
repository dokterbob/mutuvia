# Mutuvia — Environment Configuration
# Copy to .env and fill in required values.

# ── App ──
PUBLIC_APP_NAME=Mutuvia
PUBLIC_APP_TAGLINE="Together, we are more."
# If this is https://, session cookies are always sent Secure — so if
# browsers actually reach this server over plain http (e.g. TLS termination
# in front of it is missing or misconfigured), the browser drops the cookie
# and sign-in silently loops. Only set an https APP_URL once https really
# terminates in front of this server.
APP_URL=http://localhost:5173
# REQUIRED in production: min 32 characters, used to sign Better Auth sessions.
# This placeholder is deliberately invalid (too short) — the app refuses to
# start in production with it. Generate a real one: bun run generate-secret
BETTER_AUTH_SECRET=REPLACE_ME_RUN_bun_run_generate-secret

# ── Database ──
# DB_PROVIDER: 'sqlite' (default) or 'pg'
DB_PROVIDER=sqlite
# SQLite (when DB_PROVIDER=sqlite):
DB_FILE_NAME=sqlite.db
# PostgreSQL (when DB_PROVIDER=pg):
# DATABASE_URL=postgres://mutuvia:mutuvia@localhost:5432/mutuvia

# ── Currency / Unit ──
UNIT_CODE=EUR
PUBLIC_UNIT_SYMBOL=€
PUBLIC_UNIT_DISPLAY_NAME=euro

# ── QR codes ──
# Default expiry for a one-time QR (the creator can pick a different preset
# in the app: 1h/1d/3d/1w/30d). Default: 3 days. Capped at 315360000 (10
# years) — see README's "QR expiry" section.
QR_TTL_SECONDS=259200
# Default expiry for a REUSABLE QR. Unset/empty means "never expire" (the
# historical behavior, still the default). The creator can also pick "never"
# explicitly as long as QR_MAX_TTL_SECONDS below is unset. Same 10-year
# ceiling as QR_TTL_SECONDS above.
# REUSABLE_QR_TTL_SECONDS=2592000
# Optional upper bound (seconds) on any QR's expiry. Removes every preset
# above it, and removes "never" entirely. If set, QR_TTL_SECONDS and
# REUSABLE_QR_TTL_SECONDS must both be within this bound, or the app refuses
# to start — see README's "QR expiry" section. Same 10-year ceiling.
# QR_MAX_TTL_SECONDS=2592000
EXPIRED_QR_RETENTION_SECONDS=259200  # how long expired QRs stay listed (default: 3 days)
# REQUIRED: min 32 characters, used to sign QR JWTs
QR_JWT_SECRET=change-me-to-a-random-32-char-secret!!

# ── Transaction amounts ──
# Sanity bound on a SINGLE transaction's amount, in minor units (cents).
# This is NOT a credit limit — it only rejects fat-fingered or malicious
# amounts (e.g. accidental extra zeros) before they reach the ledger.
# Default (100000000 = 1,000,000.00 in a 2-decimal currency) fits PostgreSQL's
# `integer` column type. Must not exceed 2147483647 (PostgreSQL `integer`
# max) — the ledger columns are `integer` on both providers.
MAX_TRANSACTION_AMOUNT=100000000

# ── Web Push (optional) ──
# Required for push notifications to backgrounded PWA users.
# Generate keys: bunx web-push generate-vapid-keys
PUBLIC_VAPID_KEY=
PRIVATE_VAPID_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Extra push-endpoint hosts to allow beyond the built-in browser vendor list
# (fcm.googleapis.com, updates.push.services.mozilla.com,
# *.push.apple.com, *.notify.windows.com). Comma-separated; each entry is an
# exact host or a "*.suffix" wildcard.
PUSH_ENDPOINT_EXTRA_HOSTS=

# ── Android app (optional) ──
# Digital Asset Links for the Android app; see docs/android.md.
ANDROID_PACKAGE_NAME=org.mutuvia.app
ANDROID_SHA256_FINGERPRINTS=

# ── OTP delivery ──
# Without a real channel below (Prelude or SMTP), OTPs go nowhere unless this
# is set — then they're printed to the console instead, so you can sign in
# locally. Defaults off. Enabling it in production is possible but logs a
# loud startup warning, and does NOT count as a configured delivery channel.
DEV_LOG_OTP=true

# ── Rate limiting / abuse prevention ──
# Header Better Auth's rate limiter reads the client IP from. The app manages
# this header itself (see README's "Reverse proxy / client IP" section);
# only change if you have a specific reason to rename it.
TRUSTED_IP_HEADER=x-mutuvia-client-ip
# Test-only kill switches — never set these in a real deployment. Only
# honoured when NODE_ENV is development/test (never in production, no matter
# what); logs a loud startup warning whenever in effect. Used by Playwright's
# webServer for deterministic test runs.
# RATE_LIMIT_DISABLE_FOR_TESTING=true
# OTP_THROTTLE_DISABLE_FOR_TESTING=true
# Comma-separated ISO 3166-1 alpha-2 country codes (e.g. PT,NL,DE,ES,FR).
# When set, phone sign-up/OTP is restricted to these countries — an
# SMS-pumping (toll fraud) defense. Leave unset for no restriction.
PHONE_COUNTRY_ALLOWLIST=

# ── Prelude (SMS OTP) ──
# Required for production SMS OTP delivery. In dev, OTPs are logged to console
# (DEV_LOG_OTP=true above).
PRELUDE_API_TOKEN=

# ── SMTP (Email OTP) ──
# Required for production email OTP delivery. In dev, OTPs are logged to
# console (DEV_LOG_OTP=true above).
# Works with any SMTP provider: Resend, Brevo, Mailgun, Amazon SES, Postmark, etc.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   # set true for port 465 (implicit TLS); false uses STARTTLS
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mutuvia <noreply@example.com>"

# ── Community ──
PUBLIC_COMMUNITY_DOC_URL=

# ── Sentry (optional) ──
# Set PUBLIC_SENTRY_DSN to enable error tracking and the feedback widget.
# Leave blank (or unset) to disable Sentry entirely.
PUBLIC_SENTRY_DSN=
# Required only for source map uploads in CI (optional):
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Fraction of transactions sampled for performance tracing (0-1). Default:
# 0.1 (10%). Shared by client and server Sentry init — see README's
# "Security headers / Sentry" section.
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Cap on a single /sentry-tunnel request body, in bytes. Read as actual bytes
# streamed off the request, never trusting Content-Length. Default: 5000000
# (5 MB) — generous enough for a feedback envelope with a screenshot.
SENTRY_TUNNEL_MAX_BODY_BYTES=5000000

# ── Security headers ──
# HSTS max-age, in seconds. Default: 15552000 (180 days). Only sent when the
# request is seen as https (see README's "Reverse proxy / client IP" section
# for how that's determined behind a proxy) — never sent over plain http.
HSTS_MAX_AGE_SECONDS=15552000
# Off by default: this app can't know whether you control every subdomain of
# your APP_URL's domain, and HSTS with includeSubDomains is effectively
# irreversible for the max-age window across ALL of them. Set to "true" only
# if you do.
HSTS_INCLUDE_SUBDOMAINS=false
